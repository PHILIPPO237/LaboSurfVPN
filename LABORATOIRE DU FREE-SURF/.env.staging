# Active ce profil avec FS_ENV=staging
# Modele staging aligne sur la topologie de production verifiee le 2026-03-29.
# Utiliser des sous-domaines de preproduction et des secrets distincts.

FS_PANEL_BACKEND=3x-ui
FS_COOKIE_SECURE=1
FS_WEB_PUBLIC_SCHEME=https
FS_APP_PUBLIC_HOST=staging-app.example.com
FS_WEB_PUBLIC_HOST=staging-app.example.com
FS_WEB_PUBLIC_URL=https://staging-app.example.com
BASE_URL=https://staging-app.example.com

FS_PANEL_PUBLIC_HOST=staging-panel.example.com
FS_PANEL_ADMIN_HOST=staging-panel.example.com
FS_PANEL_SUBSCRIPTION_HOST=staging-sub.example.com

FS_UVICORN_HOST=0.0.0.0
FS_UVICORN_PORT=8000
FS_UVICORN_RELOAD=0
FS_LOG_LEVEL=info

FS_ADMIN_PASSWORD=change-me-staging-admin-password
FS_CSRF_SECRET=change-me-staging-session-secret

FS_REMNAWAVE_URL=https://staging-panel.example.com
FS_REMNAWAVE_API_KEY=change-me-staging-remnawave-token
FS_XRAY_CHECKER_PATH=xray-checker

# Transports a activer seulement si l'infra staging existe reellement.
FS_SSH_HOST=staging-app.example.com
FS_SSH_PORT=22
FS_SSH_DEFAULT_USER=root

FS_HYSTERIA_HOST=staging-app.example.com
FS_HYSTERIA_PORT=8443
FS_HYSTERIA_SNI=staging-panel.example.com
FS_HYSTERIA_PASS=change-me-staging-hysteria-password

FS_SLOWDNS_SERVER_HOST=staging-app.example.com
FS_SLOWDNS_DOMAIN=staging-dns.example.com
FS_SLOWDNS_NS_HOST=staging-dns.example.com
FS_SLOWDNS_PORT=5300
FS_SLOWDNS_LOCAL_PORT=22
FS_SLOWDNS_PUBKEY=replace-with-staging-pubkey

FS_ZIVPN_UDP_ENABLED=0
FS_ZIVPN_UDP_HOST=staging-app.example.com
FS_ZIVPN_UDP_PORT=5667
FS_ZIVPN_UDP_PUBLIC_PORT=5667
FS_ZIVPN_UDP_SNI=staging-app.example.com
FS_ZIVPN_UDP_FORWARD_RANGE=

FS_UDPGW_ENABLED=0
FS_UDPGW_HOST=staging-app.example.com
FS_UDPGW_PORT=7300
FS_DROPBEAR_HOST=staging-app.example.com
FS_DROPBEAR_PORT=2222
FS_DROPBEAR_USER=
