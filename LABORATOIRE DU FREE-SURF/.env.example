# =============================================================================
# LABORATOIRE DU FREE-SURF - .env.example
# =============================================================================
# Ce fichier est un modele local sans secrets reels.
# Copiez-le vers .env, .env.production ou un fichier specifique a votre environnement.
# Ne committez jamais de token Remnawave, mot de passe admin, secret de session ou SMTP reel.
# =============================================================================

# =============================================================================
# 1) TOPOLOGIE DE REFERENCE - PROD VERIFIEE LE 2026-03-29
# =============================================================================
# App publique: https://app.laboratoire.free-surf237-4all.xyz
# Panel admin / API Remnawave: https://laboratoire.free-surf237-4all.xyz
# Subscription host: https://sub.laboratoire.free-surf237-4all.xyz
# Modules actifs observes: Remnawave, SSH, SlowDNS/DNSTT, Hysteria, ZiVPN UDP
# Modules non actifs observes: Dropbear, UDPGW / UDP Custom

# =============================================================================
# 2) APP / PANEL
# =============================================================================
FS_PANEL_BACKEND=3x-ui
FS_WEB_PUBLIC_SCHEME=https
FS_APP_PUBLIC_HOST=app.laboratoire.free-surf237-4all.xyz
FS_WEB_PUBLIC_HOST=app.laboratoire.free-surf237-4all.xyz
FS_WEB_PUBLIC_URL=https://app.laboratoire.free-surf237-4all.xyz
BASE_URL=https://app.laboratoire.free-surf237-4all.xyz
FS_PANEL_PUBLIC_HOST=laboratoire.free-surf237-4all.xyz
FS_PANEL_ADMIN_HOST=laboratoire.free-surf237-4all.xyz
FS_PANEL_SUBSCRIPTION_HOST=sub.laboratoire.free-surf237-4all.xyz

# =============================================================================
# 2bis) PANEL 3X-UI - connexion au panel reel
# =============================================================================
# URL racine du panel, avec le chemin secret aleatoire si configure (ex: https://host:port/xxxxx)
FS_XUI_URL=
# Option A (recommandee) : token API - Settings > Security > API Token dans le panel
FS_XUI_TOKEN=
# Option B (repli si pas de token) : identifiants de connexion classiques
FS_XUI_USER=
FS_XUI_PASS=
# IP/host public utilise dans les configs generees pour les clients (si different de FS_PANEL_ADMIN_HOST)
FS_XUI_PUBLIC_IP=

# =============================================================================
# 3) PROCESS / LOGS / SECURITE
# =============================================================================
FS_UVICORN_HOST=0.0.0.0
FS_UVICORN_PORT=8000
FS_UVICORN_RELOAD=0
FS_LOG_LEVEL=info
FS_COOKIE_SECURE=1
FS_ADMIN_PASSWORD=change-me-admin-password
FS_CSRF_SECRET=change-me-session-secret

# =============================================================================
# 4) REMNAWAVE / SCANNER
# =============================================================================
FS_REMNAWAVE_URL=https://laboratoire.free-surf237-4all.xyz
FS_REMNAWAVE_API_KEY=change-me-remnawave-token
FS_XRAY_CHECKER_PATH=/usr/local/bin/xray-checker

# =============================================================================
# 5) SSH / HYSTERIA / SLOWDNS / ZIVPN
# =============================================================================
FS_SSH_HOST=146.19.230.203
FS_SSH_PORT=22
FS_SSH_DEFAULT_USER=root

FS_HYSTERIA_HOST=146.19.230.203
FS_HYSTERIA_PORT=8443
FS_HYSTERIA_SNI=laboratoire.free-surf237-4all.xyz
FS_HYSTERIA_PASS=change-me-hysteria-password

FS_SLOWDNS_SERVER_HOST=146.19.230.203
FS_SLOWDNS_DOMAIN=dns-laboratoire.free-surf237-4all.xyz
FS_SLOWDNS_NS_HOST=dns-laboratoire.free-surf237-4all.xyz
FS_SLOWDNS_PORT=5300
FS_SLOWDNS_LOCAL_PORT=22
FS_SLOWDNS_PUBKEY=cefa851fa6949ca3868ef950d1828a79753249a9a04e9b4f682af57a9f7a0e7b

FS_ZIVPN_UDP_ENABLED=1
FS_ZIVPN_UDP_HOST=146.19.230.203
FS_ZIVPN_UDP_PORT=5667
FS_ZIVPN_UDP_PUBLIC_PORT=5667
FS_ZIVPN_UDP_SNI=146.19.230.203
FS_ZIVPN_UDP_FORWARD_RANGE=6000:19999/udp
FS_ZIVPN_UDP_PROVISION_ENABLED=1
FS_ZIVPN_UDP_PROVISION_ENFORCE=1
FS_ZIVPN_UDP_PROVISION_PASSWORD_FIELD=license
FS_ZIVPN_UDP_PROVISION_UPSERT_COMMAND=/bin/bash /root/zivpn-udp-provision.sh
FS_ZIVPN_UDP_PROVISION_DISABLE_COMMAND=/bin/bash /root/zivpn-udp-provision.sh
FS_ZIVPN_UDP_CONFIG_FILE=/etc/zivpn/config.json
FS_ZIVPN_UDP_SYSTEMD_UNIT=zivpn

# =============================================================================
# 6) MODULES OPTIONNELS / PLANIFIES
# =============================================================================
FS_UDPGW_ENABLED=0
FS_UDPGW_HOST=146.19.230.203
FS_UDPGW_PORT=7300
FS_DROPBEAR_HOST=146.19.230.203
FS_DROPBEAR_PORT=2222
FS_DROPBEAR_USER=
