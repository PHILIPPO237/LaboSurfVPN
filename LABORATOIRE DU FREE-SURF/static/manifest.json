    {
      "action": "/import",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      },
      "icons": [
        {
          "src": "/static/icons/file-handler.png",
          "sizes": "256x256"
        }
      ],
      "launch_type": "single-client"
    }
  ]
